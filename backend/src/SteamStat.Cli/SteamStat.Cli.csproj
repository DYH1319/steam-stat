<Project Sdk="Microsoft.NET.Sdk">

    <!--
        命令行工具 steamstat：只是本地只读接口的瘦客户端，命令在 Host 里执行（/v1/cli），
        `steamstat mcp` 把 stdio 上的 MCP 消息转发到 /mcp。只用 BCL，发布时裁剪成自包含单文件，
        和 Host 放在同一个目录（build-win.ps1 / build-linux.sh）。
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>steamstat</AssemblyName>
        <RootNamespace>SteamStat.Cli</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <DebugType>None</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SteamStat.Core.Tests" />
    </ItemGroup>

</Project>
